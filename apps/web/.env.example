# Finance IA: variáveis de ambiente do app web.
# Copie para .env.local (nunca versionado) e preencha. Sem nada preenchido, o app roda em
# "modo demonstração" no desenvolvimento.
#
# Estes valores são públicos por natureza (vão para o navegador). A proteção dos dados vem das
# Security Rules e do App Check. Segredos de servidor NUNCA usam o prefixo NEXT_PUBLIC_.

# URL pública do app (metadados, links de verificação de e-mail).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase: Console → Configurações do projeto → Seus apps → App da Web ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check com reCAPTCHA Enterprise (recomendado em produção). Deixe vazio para desligar.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# "true" conecta aos emuladores locais (pnpm emulators). Não precisa de credenciais reais.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# "true" libera /dev/componentes em produção (útil em ambientes de homologação).
NEXT_PUBLIC_SHOW_DEV_PAGES=false

# --- Assistente IA (SOMENTE SERVIDOR: nunca use o prefixo NEXT_PUBLIC_) ---
# Chave da API do Claude (Anthropic). Sem ela, o assistente mostra "não configurado".
# Em produção, guarde no gerenciador de segredos da hospedagem (ex.: Secret Manager).
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-opus-5-5.
FINANCE_IA_AI_MODEL=
