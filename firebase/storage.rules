rules_version = '2';

// Finance IA: Security Rules do Cloud Storage.
// Arquivos ficam em users/{uid}/... e só o dono acessa.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Foto de perfil: imagem de até 5 MB.
    match /users/{uid}/avatar/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isOwner(uid);
    }

    // Comprovantes, importações e relatórios entram com seus módulos.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
